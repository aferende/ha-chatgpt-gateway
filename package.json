{
  "name": "ha-chatgpt-gateway",
  "version": "0.5.0",
  "description": "Self-hosted gateway connecting ChatGPT GPT Actions to Home Assistant without OpenAI API keys.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "home-assistant",
    "chatgpt",
    "gpt-actions",
    "gateway",
    "docker",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/proxy-addr": "^5.1.0",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^5.0.1"
  }
}
