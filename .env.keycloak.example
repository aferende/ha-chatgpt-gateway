# Private provider settings. The gateway must not receive this environment file.
OAUTH_PUBLIC_URL=https://gateway.example.com/oauth
OAUTH_PORT=8790
OAUTH_ADMIN_USER=gateway-admin
# Generate each independently: openssl rand -hex 32
OAUTH_ADMIN_PASSWORD=
OAUTH_DB_PASSWORD=
CHATGPT_REDIRECT_URI=
MCP_PUBLIC_URL=https://gateway.example.com/mcp
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8790/oauth
KEYCLOAK_ACCESS_FILE=private/keycloak-access.txt
