PORT=8787

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Generate each key independently with: openssl rand -hex 32
# Each value must be exactly 64 hexadecimal characters (256-bit nominal entropy).
# Backward-compatible full-access key. Prefer the two distinct scoped keys below for a new deployment.
GATEWAY_API_KEY=
# Optional read-only key for monitoring/discovery clients. It cannot call services.
GATEWAY_READ_API_KEY=
# Optional read+write key for the GPT Action. It must differ from every other configured gateway key.
GATEWAY_WRITE_API_KEY=

# First-run discovery policy: keep this small and READ_ONLY=true.
# After discovery, replace ALLOWED_ENTITIES with a short list of safe, real IDs.
# READ_ONLY=false refuses to start if this value is empty.
ALLOWED_DOMAINS=light,switch
ALLOWED_ENTITIES=

READ_ONLY=true

# Optional logbook access for troubleshooting. Disabled by default.
# Requests remain authenticated/rate-limited and filtered through the existing entity/domain policy.
# Unscoped requests are limited to 24 hours; entity-scoped requests may span up to 7 days.
# Responses are capped at 500 entries and omit state values unless include_state=true is requested.
# Redaction is defense in depth only; authorization, filtering, range bounds, and state minimization
# are the primary disclosure controls.
ENABLE_LOGBOOK=false

# Optional bounded Home Assistant Core warning/error records and traceback context
# through the separate diagnostics companion.
# Disabled by default. When enabled, both companion settings below are required.
# The token must match the companion option and contain exactly 64 hexadecimal characters.
ENABLE_ERROR_LOGS=false
DIAGNOSTICS_ADDON_URL=
DIAGNOSTICS_ADDON_TOKEN=

LOG_LEVEL=info

# Timeout for reads, discovery, and internal WebSocket registry requests.
HOME_ASSISTANT_TIMEOUT_MS=10000

# Synchronous entity-targeted service calls can take longer than reads.
HOME_ASSISTANT_SERVICE_TIMEOUT_MS=30000

# Opt-in queueing for long-running entity-targeted services such as automations or scripts.
# Queued calls return HTTP 202 immediately; query their dispatch ID for eventual status.
ENABLE_ASYNC_SERVICE_DISPATCH=false
ASYNC_SERVICE_DOMAINS=
HOME_ASSISTANT_ASYNC_SERVICE_TIMEOUT_MS=1800000
ASYNC_SERVICE_MAX_CONCURRENT=2

# Opt-in, exact allow-list for a small set of target-less maintenance actions.
# Supported values: homeassistant.check_config, homeassistant.reload_all,
# homeassistant.reload_core_config, homeassistant.reload_custom_templates,
# homeassistant.restart, automation.reload, scene.reload, script.reload.
ENABLE_ADMIN_ACTIONS=false
ADMIN_ALLOWED_ACTIONS=

# Per-client in-memory rate limit for all protected API requests, including failed authentication. Set MAX=0 to disable.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Stricter per-credential limit for service calls. Set MAX=0 only behind another trusted limiter.
SERVICE_RATE_LIMIT_MAX=20
SERVICE_RATE_LIMIT_WINDOW_MS=60000

# Comma-separated IPs/CIDRs of reverse-proxy peers allowed to supply forwarding headers.
# Leave empty to trust nobody. For a same-host Synology proxy, use 127.0.0.1 only after verifying it is the peer seen by the container.
TRUSTED_PROXIES=

# Optional public HTTPS URL advertised in /openapi.json. Set this when a reverse proxy is used.
PUBLIC_BASE_URL=https://gateway.example.com
